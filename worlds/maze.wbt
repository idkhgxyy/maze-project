#VRML_SIM R2023b utf8

WorldInfo {
  basicTimeStep 16
}

Viewpoint {
  orientation -0.5774 0.5774 0.5774 2.0944
  position 0 0 3.2
}

DirectionalLight {
  direction -0.3 0.3 -1
  intensity 1.4
  ambientIntensity 0.4
}

DEF FLOOR Solid {
  children [
    DEF FLOOR_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.45 0.48
        roughness 1
        metalness 0
      }
      geometry Plane {
        size 4 4
      }
    }
  ]
  name "floor"
  boundingObject USE FLOOR_SHAPE
  locked TRUE
}

DEF START_PAD Solid {
  translation -1.0 -1.0 0.001
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.15 0.75 0.3
        roughness 1
        metalness 0
      }
      geometry Box {
        size 0.5 0.5 0.002
      }
    }
  ]
  name "起点"
}

DEF FINISH_PAD Solid {
  translation 1.0 1.0 0.001
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.45 0.05
        roughness 1
        metalness 0
      }
      geometry Box {
        size 0.5 0.5 0.002
      }
    }
  ]
  name "终点"
}

