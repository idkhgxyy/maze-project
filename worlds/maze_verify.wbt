}

DEF FLOOR Solid {
  children [
    DEF FLOOR_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.92 0.88 0.82
        roughness 1
        metalness 0
      }
      geometry Plane {
        size 9 9
      }
    }
  ]
  name "floor"
  boundingObject USE FLOOR_SHAPE
  locked TRUE
}

